# Required in Vercel Production and Preview. Client-safe Supabase values.
# NEXT_PUBLIC_* values are embedded in the browser bundle during the Vercel build.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only. Required only when trusted admin/background jobs use createAdminClient.
SUPABASE_SERVICE_ROLE_KEY=

# Server-only Groq outreach generation. Never prefix with NEXT_PUBLIC_.
GROQ_API_KEY=
GROQ_MODEL=
GROQ_VISION_MODEL=
